#!/bin/bash
# Thiet lap chay MOT LAN o lan khoi dong dau tien cua may nay.
#
# VI SAO khong lam san trong ISO: file ISO la cong khai, ai cung tai duoc.
# Moi bi mat nhet san trong do se GIONG HET NHAU tren moi may cai tu no -
# tuc la khong con la bi mat. Nguyen tac nay da ap dung cho mat khau Samba
# va tai khoan kho trung tam tu truoc; day la lan ap dung thu ba.
set -e
DAU="/var/lib/console-pi/.da-thiet-lap"
[ -f "$DAU" ] && exit 0
mkdir -p /var/lib/console-pi

# 1. Mat khau kho Samba - rieng cho tung may
KHOA=/var/lib/console-pi/samba-deploy.key
if [ ! -f "$KHOA" ]; then
    head -c 18 /dev/urandom | base64 | tr -d "/+=" | head -c 20 > "$KHOA"
    chmod 600 "$KHOA"
    # Tai khoan PHAI la "consolepi-deploy" - dung ten share [deploy] trong
    # config/smb.conf (valid users) va ten deploy.cmd dung (ui/unattend.py).
    # LOI THAT 26/09/2026: truoc day tao nham "deploy" -> WinPE `net use`
    # bao System error 1312, khong lay duoc install.wim. (ui/pxe.py cung tu
    # sua lai moi lan bat PXE cho may da cai tu ban loi.)
    if id -u consolepi-deploy >/dev/null 2>&1 || \
       useradd --system --no-create-home --shell /usr/sbin/nologin consolepi-deploy 2>/dev/null; then
        printf "%s\n%s\n" "$(cat $KHOA)" "$(cat $KHOA)" | smbpasswd -s -a consolepi-deploy >/dev/null 2>&1 || true
        smbpasswd -e consolepi-deploy >/dev/null 2>&1 || true
    fi
fi

touch "$DAU"

# --- 7. MAN HINH: tu bat giao dien kiosk neu may CO man hinh that ---
#
# Anh Thoai yeu cau (20/09/2026): may co man hinh nhu laptop thi phai hien
# giao dien len ngay tren may do, giong con Pi RasPad dang chay.
#
# HAI VAN DE PHAI XU LY, ca hai deu chi lo ra tren may x86 chu khong phai
# tren Pi:
#
# (a) TEN NGUOI DUNG VIET CUNG. File console-pi-kiosk.service ghi thang
#     "User=administrator" va "XDG_RUNTIME_DIR=/run/user/1000" - dung tren
#     con Pi (tai khoan ten administrator) nhung SAI tren ban ISO: ban
#     chay thu tu USB dung tai khoan "user", con ban cai len o cung thi
#     dung ten ma nguoi cai tu dat. Sai ten la cage khong co quyen truy
#     cap man hinh, dich vu chet lien tuc. Sua bang drop-in systemd sinh
#     tai day theo tai khoan uid 1000 THAT cua may - khong sua file .service
#     goc de con Pi khong bi anh huong.
#
# (b) KHONG PHAI MAY NAO CUNG CO MAN HINH. May chu cam trong rack, hoac
#     may ao chay headless, bat kiosk len la no that bai roi khoi dong lai
#     vo han (Restart=always) lam day nhat ky. Vi vay chi bat khi THAT SU
#     co man hinh dang cam: doc /sys/class/drm/*/status tim cong nao bao
#     "connected". Them ConditionPathExists=/dev/dri/card0 de ngay ca khi
#     doan tren doan nham, systemd cung bo qua mot cach im lang thay vi
#     lap vo han.
_nd="$(getent passwd 1000 2>/dev/null | cut -d: -f1 || true)"
if [ -n "$_nd" ]; then
    _uid="$(id -u "$_nd" 2>/dev/null || echo 1000)"

    # --- Bao ho: tai khoan cai dat PHAI co quyen sudo ---
    # LOI THAT DA GAP (22/09/2026, anh Thoai cai xong khong sudo duoc):
    # "administrator is not in the sudoers file". Nguyen nhan da xac dinh:
    # d-i chi tu them "sudo" vao nhom mac dinh cua tai khoan moi NEU goi
    # sudo da co san luc no hoi tao tai khoan - nhung goi sudo cua du an
    # nam trong danh sach rieng, cai o buoc sau, nen bi bo sot. Da dien
    # san "d-i passwd/user-default-groups" trong preseed.cfg de sua tan
    # goc, nhung van kiem tra lai o day mot lan nua cho chac (khong hai gi
    # neu da dung san - lenh idempotent) - phong khi ban ISO cu (chua co
    # preseed moi) van con luu hanh, hoac co duong cai nao khac bo qua.
    if ! id -nG "$_nd" 2>/dev/null | tr ' ' '\n' | grep -qx sudo; then
        usermod -aG sudo "$_nd" 2>/dev/null \
            && echo "[console-system] da them $_nd vao nhom sudo (thieu tu luc cai)"
    fi
    for _u in console-pi-kiosk console-pi-kiosk-helper; do
        mkdir -p "/etc/systemd/system/${_u}.service.d"
        {
            echo "[Service]"
            echo "User=${_nd}"
            echo "Group=${_nd}"
            echo "Environment=XDG_RUNTIME_DIR=/run/user/${_uid}"
        } > "/etc/systemd/system/${_u}.service.d/10-nguoi-dung.conf"
    done
    # CHON CACH VE (GPU hay CPU) + CHO card do hoa + CANH GAC - xem giai
    # thich day du trong /usr/local/sbin/console-system-kiosk-ve. Tom tat:
    # Intel/AMD (ca card roi lan iGPU trong CPU) ve bang GPU; may ao, card
    # may chu, nouveau... ve bang CPU; GPU loi (90s chua co trinh duyet)
    # thi tu doi sang CPU. LOI THAT dan toi thiet ke nay: VMware khong 3D
    # lam cage TREO (24/09/2026) - man hinh den vinh vien.
    # TimeoutStopSec=15: cage treo bo qua SIGTERM, mac dinh systemd cho 90s
    # moi giet - canh gac khoi dong lai kiosk se bi cham theo.
    {
        echo "[Service]"
        echo "ExecStartPre=+/usr/local/sbin/console-system-kiosk-ve chuan-bi"
        echo "EnvironmentFile=-/run/console-pi-kiosk.env"
        echo "ExecStartPost=+/usr/local/sbin/console-system-kiosk-ve canh-gac"
        echo "ExecStopPost=+/usr/local/sbin/console-system-kiosk-ve sau-khi-dung"
        echo "TimeoutStopSec=15"
    } > /etc/systemd/system/console-pi-kiosk.service.d/15-cho-man-hinh.conf
    rm -f /etc/systemd/system/console-pi-kiosk.service.d/16-ve-bang-cpu.conf

    # --- Kiosk loi thi TRA tty1 ve cho dong lenh ---
    # Kiosk chiem tty1 va tat getty (Conflicts=getty@tty1). Neu cage/Chromium
    # khong khoi dong duoc (may khong co tang toc do hoa, driver loi...) thi
    # Restart=always cu lap lai mai, tty1 den vinh vien, nguoi dung khong con
    # dau nhac dang nhap lan dia chi IP de vao web. Gioi han: loi 5 lan trong
    # 5 phut thi dung han va bat lai getty@tty1 - man hinh quay ve dong lenh
    # co logo + dia chi IP nhu may khong co man hinh.
    mkdir -p /etc/systemd/system/console-pi-kiosk.service.d
    {
        echo "[Unit]"
        echo "StartLimitIntervalSec=300"
        echo "StartLimitBurst=5"
        echo "OnFailure=getty@tty1.service"
        # LOI THAT (23/09/2026, anh Thoai bam "Tat giao dien man hinh" tren
        # mini PC Dell): man hinh DEN THUI, chi con con tro nhap nhay, khong
        # quay ve dong lenh. Kiosk tat getty@tty1 luc chay (Conflicts) nhung
        # luc TAT kiosk thi khong ai bat lai getty. Sua: tat kiosk BINH
        # THUONG (nut tren web, systemctl stop/disable) -> bat lai getty.
        # KHONG bat getty khi:
        #  - kiosk bi loi/crash (SERVICE_RESULT khac success): de
        #    Restart=always tu chay lai; loi mai thi da co OnFailure.
        #  - dang RESTART kiosk (vd doi xoay man hinh o tab Cai dat goi
        #    `systemctl restart`). LOI THAT (24/09/2026, bat duoc khi test
        #    ban 1.2.3): restart = dung roi chay lai; buoc dung bat getty,
        #    getty (Conflicts) da luon kiosk vua chay lai -> mat kiosk, ve
        #    dong lenh. Phan biet bang loai job systemd dang chay cho kiosk:
        #    "restart" hay "stop" (da thu that: bat/restart/crash/stop/
        #    bat lai/restart/disable --now - ca 7 truong hop dung).
        cat <<'DROPIN'
[Service]
ExecStopPost=+/bin/sh -c '[ "$$SERVICE_RESULT" = success ] || exit 0; systemctl list-jobs --no-legend | grep -qE "console-pi-kiosk.service +(start|restart|try-restart|reload-or-start)" && exit 0; systemctl start --no-block getty@tty1.service; true'
DROPIN
    } > /etc/systemd/system/console-pi-kiosk.service.d/20-tra-man-hinh.conf
    # Bo gioi han khoi dong lai cua getty tren tty1. Ly do - da do that:
    # OnFailure bat getty moi lan kiosk loi, roi kiosk thu lai thi lai tat
    # getty (Conflicts). Qua lai 5 lan trong vai giay thi CHINH getty bi
    # systemd chan "Start request repeated too quickly" (start-limit-hit) ->
    # kiosk da dung ma tty1 van den. getty khoi dong lai bao nhieu lan cung
    # vo hai, nen bo gioi han cho rieng no.
    mkdir -p /etc/systemd/system/getty@tty1.service.d
    {
        echo "[Unit]"
        echo "StartLimitIntervalSec=0"
    } > /etc/systemd/system/getty@tty1.service.d/20-khong-gioi-han.conf

    # LOI THAT (23/09/2026, anh Thoai cai len mini PC Dell co cam man
    # hinh): cai xong KHONG vao kiosk, chi co dong lenh - bat tay bang
    # `systemctl start console-pi-kiosk` thi hien binh thuong. Truoc day
    # chi bat kiosk khi luc nay doc /sys/class/drm/*/status thay
    # "connected", nhung script nay chay RAT SOM trong luc boot - driver man
    # hinh chua nap xong thi chua co gi de doc, ket luan nham "khong co man
    # hinh", ma script chi chay 1 lan nen khong bao gio bat lai.
    # Anh Thoai chot: cai xong la BAT KIOSK LUON; may nao khong dung man
    # hinh thi khong cam man hinh (kiosk chay khong ai nhin, vo hai).
    _co_man_hinh=1

    # May ao CUNG bat kiosk (anh Thoai 24/09/2026: "lo nhu sau nay user
    # chay tren may ao thi sao") - ve bang CPU, do console-system-kiosk-ve
    # tu nhan ra luc kiosk khoi dong. Ban 1.2.x truoc do bo qua may ao vi
    # VMware khong 3D lam man hinh den.

    if [ "$_co_man_hinh" = "1" ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        # KHONG DUOC DUNG `enable --now` O DAY - DA LAM TREO BOOT THAT.
        # `--now` = enable roi START VA DOI cho start xong. Nhung dich vu nay
        # chay TRONG luc boot, truoc multi-user.target; kiosk lai xep hang sau
        # multi-user.target -> no doi kiosk, kiosk doi no: ket cung vinh vien.
        # Kiem chung 20/09/2026 tren may ao: sau 9 phut van "activating", keo
        # theo dashboard/ttyd/kiosk deu ket o trang thai "waiting", nginx song
        # nhung moi trang deu 502 - coi nhu ca he thong chet.
        # SUA: enable (ghi dau moc, khong sinh viec) roi start --no-block
        # (xep hang xong tra ve ngay), de systemd tu chay kiosk khi den luot.
        systemctl enable console-pi-kiosk console-pi-kiosk-helper >/dev/null 2>&1 || true
        if systemctl start --no-block console-pi-kiosk console-pi-kiosk-helper >/dev/null 2>&1; then
            echo "[console-system] da bat giao dien kiosk"
        else
            echo "[console-system] khong bat duoc kiosk"
        fi
    fi
fi

# --- 8. MANG: bo ho so "Wired connection N" KHONG gan card cua trinh cai dat ---
#
# LOI THAT (26/09/2026, may ao 2 card mang cai tu ISO): trinh cai dat de lai
# DUNG 1 ho so NetworkManager "Wired connection 1" KHONG gan vao card nao
# (khong interface-name, khong mac). NetworkManager chi dung 1 ho so cho 1
# card mot luc: no dem ho so do cam vao card KHONG co DHCP (ens4) va thu lai
# mai, card CO DHCP (ens3) thi khong co ho so nao -> ca may khong co mang.
# May khach co 2 cong LAN (onboard + card roi, rat pho bien) se dinh ngay.
# SUA: xoa ho so DHCP khong gan card do; NetworkManager tu tao ho so rieng
# cho TUNG card (hanh vi mac dinh). Ho so IP tinh / da gan card thi GIU.
for _f in /etc/NetworkManager/system-connections/*; do
    [ -f "$_f" ] || continue
    grep -qE '^type=(802-3-ethernet|ethernet)' "$_f" || continue
    grep -qE '^(interface-name|mac-address)=' "$_f" && continue
    grep -qE '^method=manual' "$_f" && continue
    echo "[console-system] bo ho so mang khong gan card: $(basename "$_f")"
    rm -f "$_f"
done
nmcli connection reload >/dev/null 2>&1 || true

#!/bin/bash
# Thiet lap chay MOT LAN o lan khoi dong dau tien cua may nay.
#
# VI SAO khong lam san trong ISO: file ISO la cong khai, ai cung tai duoc.
# Moi bi mat nhet san trong do se GIONG HET NHAU tren moi may cai tu no -
# tuc la khong con la bi mat. Nguyen tac nay da ap dung cho mat khau Samba
# va tai khoan kho trung tam tu truoc; day la lan ap dung thu ba.
set -e
DAU="/var/lib/console-pi/.da-thiet-lap"
[ -f "$DAU" ] && exit 0
mkdir -p /var/lib/console-pi

# 1. Mat khau kho Samba - rieng cho tung may
KHOA=/var/lib/console-pi/samba-deploy.key
if [ ! -f "$KHOA" ]; then
    head -c 18 /dev/urandom | base64 | tr -d "/+=" | head -c 20 > "$KHOA"
    chmod 600 "$KHOA"
    if id -u deploy >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin deploy 2>/dev/null; then
        printf "%s\n%s\n" "$(cat $KHOA)" "$(cat $KHOA)" | smbpasswd -s -a deploy >/dev/null 2>&1 || true
    fi
fi

touch "$DAU"

# --- 7. MAN HINH: tu bat giao dien kiosk neu may CO man hinh that ---
#
# Anh Thoai yeu cau (20/09/2026): may co man hinh nhu laptop thi phai hien
# giao dien len ngay tren may do, giong con Pi RasPad dang chay.
#
# HAI VAN DE PHAI XU LY, ca hai deu chi lo ra tren may x86 chu khong phai
# tren Pi:
#
# (a) TEN NGUOI DUNG VIET CUNG. File console-pi-kiosk.service ghi thang
#     "User=administrator" va "XDG_RUNTIME_DIR=/run/user/1000" - dung tren
#     con Pi (tai khoan ten administrator) nhung SAI tren ban ISO: ban
#     chay thu tu USB dung tai khoan "user", con ban cai len o cung thi
#     dung ten ma nguoi cai tu dat. Sai ten la cage khong co quyen truy
#     cap man hinh, dich vu chet lien tuc. Sua bang drop-in systemd sinh
#     tai day theo tai khoan uid 1000 THAT cua may - khong sua file .service
#     goc de con Pi khong bi anh huong.
#
# (b) KHONG PHAI MAY NAO CUNG CO MAN HINH. May chu cam trong rack, hoac
#     may ao chay headless, bat kiosk len la no that bai roi khoi dong lai
#     vo han (Restart=always) lam day nhat ky. Vi vay chi bat khi THAT SU
#     co man hinh dang cam: doc /sys/class/drm/*/status tim cong nao bao
#     "connected". Them ConditionPathExists=/dev/dri/card0 de ngay ca khi
#     doan tren doan nham, systemd cung bo qua mot cach im lang thay vi
#     lap vo han.
_nd="$(getent passwd 1000 2>/dev/null | cut -d: -f1 || true)"
if [ -n "$_nd" ]; then
    _uid="$(id -u "$_nd" 2>/dev/null || echo 1000)"

    # --- Bao ho: tai khoan cai dat PHAI co quyen sudo ---
    # LOI THAT DA GAP (22/09/2026, anh Thoai cai xong khong sudo duoc):
    # "administrator is not in the sudoers file". Nguyen nhan da xac dinh:
    # d-i chi tu them "sudo" vao nhom mac dinh cua tai khoan moi NEU goi
    # sudo da co san luc no hoi tao tai khoan - nhung goi sudo cua du an
    # nam trong danh sach rieng, cai o buoc sau, nen bi bo sot. Da dien
    # san "d-i passwd/user-default-groups" trong preseed.cfg de sua tan
    # goc, nhung van kiem tra lai o day mot lan nua cho chac (khong hai gi
    # neu da dung san - lenh idempotent) - phong khi ban ISO cu (chua co
    # preseed moi) van con luu hanh, hoac co duong cai nao khac bo qua.
    if ! id -nG "$_nd" 2>/dev/null | tr ' ' '\n' | grep -qx sudo; then
        usermod -aG sudo "$_nd" 2>/dev/null \
            && echo "[console-system] da them $_nd vao nhom sudo (thieu tu luc cai)"
    fi
    for _u in console-pi-kiosk console-pi-kiosk-helper; do
        mkdir -p "/etc/systemd/system/${_u}.service.d"
        {
            echo "[Unit]"
            echo "ConditionPathExists=/dev/dri/card0"
            echo "[Service]"
            echo "User=${_nd}"
            echo "Group=${_nd}"
            echo "Environment=XDG_RUNTIME_DIR=/run/user/${_uid}"
        } > "/etc/systemd/system/${_u}.service.d/10-nguoi-dung.conf"
    done

    # --- Kiosk loi thi TRA tty1 ve cho dong lenh ---
    # Kiosk chiem tty1 va tat getty (Conflicts=getty@tty1). Neu cage/Chromium
    # khong khoi dong duoc (may khong co tang toc do hoa, driver loi...) thi
    # Restart=always cu lap lai mai, tty1 den vinh vien, nguoi dung khong con
    # dau nhac dang nhap lan dia chi IP de vao web. Gioi han: loi 5 lan trong
    # 5 phut thi dung han va bat lai getty@tty1 - man hinh quay ve dong lenh
    # co logo + dia chi IP nhu may khong co man hinh.
    mkdir -p /etc/systemd/system/console-pi-kiosk.service.d
    {
        echo "[Unit]"
        echo "StartLimitIntervalSec=300"
        echo "StartLimitBurst=5"
        echo "OnFailure=getty@tty1.service"
    } > /etc/systemd/system/console-pi-kiosk.service.d/20-tra-man-hinh.conf
    # Bo gioi han khoi dong lai cua getty tren tty1. Ly do - da do that:
    # OnFailure bat getty moi lan kiosk loi, roi kiosk thu lai thi lai tat
    # getty (Conflicts). Qua lai 5 lan trong vai giay thi CHINH getty bi
    # systemd chan "Start request repeated too quickly" (start-limit-hit) ->
    # kiosk da dung ma tty1 van den. getty khoi dong lai bao nhieu lan cung
    # vo hai, nen bo gioi han cho rieng no.
    mkdir -p /etc/systemd/system/getty@tty1.service.d
    {
        echo "[Unit]"
        echo "StartLimitIntervalSec=0"
    } > /etc/systemd/system/getty@tty1.service.d/20-khong-gioi-han.conf

    _co_man_hinh=0
    for _s in /sys/class/drm/*/status; do
        [ -e "$_s" ] || continue
        if grep -qx "connected" "$_s" 2>/dev/null; then _co_man_hinh=1; fi
    done

    # --- May ao: KHONG tu bat kiosk ---
    # LOI THAT (21/09/2026, anh Thoai cai len VMware Workstation): cai xong
    # man hinh DEN THUI, khong hien gi. Nguyen nhan: card do hoa AO luc nao
    # cung bao man hinh "connected" (VMware: Virtual-1, QEMU: Virtual-1...),
    # nen doan kiem tra o tren tuong co man hinh that va bat kiosk. Kiosk
    # chiem tty1, ma VMware cua anh Thoai chay tren Hyper-V nen KHONG co tang
    # toc 3D (vmware.log: "SVGA3dCaps: Disabling 3d support") - Chromium khong
    # ve duoc gi, man hinh den vinh vien, mat luon dau nhac dang nhap lan dia
    # chi IP. Da do tren may ao co card do hoa thuong: kiosk van hien duoc
    # nhung mat ~3 phut, suot luc do den hoan toan.
    # May ao thi luon vao web tu trinh duyet may that - kiosk khong co ich gi
    # ma chi them rui ro. Can thi van bat tay duoc o tab Cai dat.
    _may_ao="$(systemd-detect-virt --vm 2>/dev/null || true)"
    if [ -n "$_may_ao" ] && [ "$_may_ao" != "none" ]; then
        _co_man_hinh=0
        echo "[console-system] dang chay tren may ao ($_may_ao) - khong tu bat kiosk"
    fi

    if [ "$_co_man_hinh" = "1" ] && [ -e /dev/dri/card0 ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        # KHONG DUOC DUNG `enable --now` O DAY - DA LAM TREO BOOT THAT.
        # `--now` = enable roi START VA DOI cho start xong. Nhung dich vu nay
        # chay TRONG luc boot, truoc multi-user.target; kiosk lai xep hang sau
        # multi-user.target -> no doi kiosk, kiosk doi no: ket cung vinh vien.
        # Kiem chung 20/09/2026 tren may ao: sau 9 phut van "activating", keo
        # theo dashboard/ttyd/kiosk deu ket o trang thai "waiting", nginx song
        # nhung moi trang deu 502 - coi nhu ca he thong chet.
        # SUA: enable (ghi dau moc, khong sinh viec) roi start --no-block
        # (xep hang xong tra ve ngay), de systemd tu chay kiosk khi den luot.
        systemctl enable console-pi-kiosk console-pi-kiosk-helper >/dev/null 2>&1 || true
        if systemctl start --no-block console-pi-kiosk console-pi-kiosk-helper >/dev/null 2>&1; then
            echo "[console-system] co man hinh - da bat giao dien kiosk"
        else
            echo "[console-system] co man hinh nhung khong bat duoc kiosk"
        fi
    else
        echo "[console-system] khong thay man hinh - bo qua kiosk (bat tay o tab Cai dat neu can)"
    fi
fi

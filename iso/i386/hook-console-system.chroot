#!/bin/sh
# ===================================================================
# Console System - thiet lap ben trong anh dia ISO
# ===================================================================
# Chay MOT LAN luc build, ben trong chroot cua live-build. O day KHONG co
# systemd dang chay, nen chi duoc dung `systemctl enable` (chi tao lien ket
# trong /etc/systemd/system/*.wants/) - tuyet doi khong goi start/restart.
set -e

echo "[console-system] bat dau thiet lap"

# --- 1. Thu muc du lieu (tach khoi ma nguon - xem ui/duongdan.py) ---
mkdir -p /var/lib/console-pi/deploy /var/lib/console-pi/storage
chmod 755 /var/lib/console-pi

# --- 1b. ttyd (KHONG co trong kho Debian - phai tai ban binary) ---
#
# LOI THAT (20/09/2026, boot thu ISO trong may ao): moi trang terminal
# (/term-local/, /term-ssh/, /term-console/ttyUSBx/) deu tra 502 Bad Gateway.
# Nguyen nhan: danh-sach-goi.txt co tmux nhung KHONG co ttyd - ma ttyd
# khong nam trong kho Debian (kiem tra that: ca trixie lan bookworm deu
# "Candidate: (none)"), nen khong the them vao danh sach goi duoc. Ban cai
# len Pi lay ttyd tu GitHub (xem install.sh) con ban ISO thi tu truoc den
# gio quen han buoc do -> console-pi-term-local chay roi chet lap vo han
# voi ma 127 (khong tim thay lenh), nginx thi van song nen nguoi dung chi
# thay 502 chu khong biet thieu cai gi.
#
# Tai ngay tai day, trong chroot, theo dung kien truc dang dung. De `set -e`
# lam do vo ban build neu tai that bai: tha hong luc build con hon giao ra
# ban ISO co terminal chet.
case "$(dpkg --print-architecture)" in
    amd64) TTYD_ARCH=x86_64 ;;
    i386)  TTYD_ARCH=i686 ;;
    *) echo "[console-system] kien truc la, khong biet lay ttyd nao"; exit 1 ;;
esac
curl -fsSL "https://github.com/tsl0922/ttyd/releases/latest/download/ttyd.${TTYD_ARCH}" \
     -o /usr/local/bin/ttyd
chmod 755 /usr/local/bin/ttyd
/usr/local/bin/ttyd --version >/dev/null 2>&1 || {
    echo "[console-system] ttyd tai ve nhung khong chay duoc"; exit 1; }
echo "[console-system] da cai ttyd: $(/usr/local/bin/ttyd --version 2>&1 | head -1)"

# --- 2. Cac don vi systemd ---
for f in /usr/local/share/console-system/systemd/*.service /usr/local/share/console-system/systemd/*.timer; do
    [ -f "$f" ] || continue
    install -m 644 "$f" /etc/systemd/system/
done

# CHI bat nhung dich vu co y nghia tren may x86. CO Y BO:
#   - console-pi-kiosk*    : can man hinh cam ung + cage, may ban khong co
#   - bt-*, dnsmasq-bt     : Bluetooth PAN cua RasPad
#   - wifi-fallback        : gan chat cach Pi quan ly wlan0
#   - dnsmasq-pxe/direct   : dich vu mang KHONG xac thuc, khong bao gio
#                            duoc tu bat luc khoi dong (nguyen tac an toan
#                            xuyen suot du an) - nguoi dung tu bat khi can
for s in console-pi-dashboard console-pi-term-local console-pi-term-ssh \
         nginx lldpd avahi-daemon ssh NetworkManager \
         console-system-lan-dau; do
    systemctl enable "$s" >/dev/null 2>&1 || echo "[console-system] khong bat duoc $s"
done

# --- 2b. TAT cac dich vu MANG tu bat theo goi ---
#
# LOI THAT BAT DUOC KHI KIEM TRA RUOT ISO (19/09/2026, truoc khi giao cho
# anh Thoai): tren Debian, cai goi la goi TU BAT dich vu. Ket qua la anh
# dia vua dung xong co san dnsmasq (DHCP server), hostapd (phat WiFi),
# tftpd-hpa va samba deu o trang thai enabled - tuc la may cai tu ISO nay
# BOOT LEN LA PHAT DHCP RA MANG. Cam vao mang cong ty la thanh DHCP lau,
# may khac nhan IP sai, sap mang khach.
#
# Day dung la dieu install.sh tren Pi da lo tu lau; ban ISO thi chua. Tat
# tuong minh o day. Chung KHONG bi go bo - van cai san de nguoi dung bat
# khi that su can (bat qua giao dien, co canh bao ro rang).
for s in dnsmasq hostapd tftpd-hpa smbd nmbd winbind samba-ad-dc \
         wpa_supplicant; do
    systemctl disable "$s" >/dev/null 2>&1 || true
    systemctl mask "$s" >/dev/null 2>&1 || true
done
# Bo mask rieng cho smbd/dnsmasq: chung duoc dieu khien tu giao dien (PXE,
# cam thang thiet bi) nen phai bat len duoc luc can - chi khong tu chay.
for s in dnsmasq smbd nmbd hostapd tftpd-hpa wpa_supplicant; do
    systemctl unmask "$s" >/dev/null 2>&1 || true
    systemctl disable "$s" >/dev/null 2>&1 || true
done

# --- 3. nginx ---
if [ -f /usr/local/share/console-system/config/nginx-console-pi.conf ]; then
    install -m 644 /usr/local/share/console-system/config/nginx-console-pi.conf \
        /etc/nginx/sites-available/console-pi.conf
    ln -sf /etc/nginx/sites-available/console-pi.conf /etc/nginx/sites-enabled/console-pi.conf
    rm -f /etc/nginx/sites-enabled/default
fi

# --- 4. Cac cau hinh phu ---
[ -f /usr/local/share/console-system/config/99-consolepi-serial.rules ] && \
    install -m 644 /usr/local/share/console-system/config/99-consolepi-serial.rules /etc/udev/rules.d/
[ -f /usr/local/share/console-system/config/smb.conf ] && \
    install -m 644 /usr/local/share/console-system/config/smb.conf /etc/samba/smb.conf

# --- 5. Mat khau kho Samba: SINH NGAU NHIEN o lan khoi dong DAU TIEN ---
#
# LOI THAT (20/09/2026, bat duoc khi SSH vao ISO dang chay va kiem tra
# `systemctl is-enabled`): unit console-system-lan-dau.service CO trong
# anh dia nhung o trang thai "disabled" - da tao file ma QUEN BAT. Ket
# qua: mat khau kho Samba khong bao gio duoc sinh, va khi nguoi dung bat
# PXE thi may can cai khong ket noi duoc kho trien khai - loi chi hien ra
# dung luc dang cai cho khach. Da them vao danh sach bat o tren.
# TUYET DOI khong sinh o day: ISO la file cong khai ai cung tai duoc, nhet
# mat khau vao la moi ban cai deu dung chung mot mat khau.
mkdir -p /usr/local/share/console-system

echo "[console-system] xong"

# --- 6. THUONG HIEU: he thong tu khai la Console System ---
#
# VI SAO VIET O DAY chu khong dat file trong includes.chroot: live-build
# chep includes.chroot vao TRUOC khi cai goi, roi goi base-files GHI DE len
# /etc/os-release - ban ISO van tu khai la "Debian GNU/Linux 13" du da dat
# file (da kiem chung: mount ISO ra xem thay dung nhu vay). Con thu muc
# includes.chroot_after_packages thi live-build TU CHOI dung chung voi
# includes.chroot ("Only one directory is allowed"). Hook chay SAU khi cai
# goi xong nen viet o day la chac an nhat.
#
# GIU NGUYEN ID=debian: rat nhieu cong cu (apt, script kiem tra he dieu
# hanh, goi cua ben thu ba) doc truong nay de biet dang chay tren ho Debian
# nao. Doi ten cho dep ma lam hong viec cai goi thi khong dang. Chi doi
# NAME/PRETTY_NAME la thu nguoi dung NHIN THAY.
rm -f /etc/os-release
cat > /etc/os-release << 'OSR'
PRETTY_NAME="Console System 1.0 (32-bit)"
NAME="Console System"
VERSION_ID="12"
VERSION="1.0 32-bit (tren Debian 12 bookworm)"
ID=debian
HOME_URL="https://github.com/zTieuYeuz/server-consolepi"
OSR

printf 'Console System 1.0  \\n \\l\n\n' > /etc/issue

echo "[console-system] da dat thuong hieu"

[Unit]
Description=Console Pi - Terminal cho SSH (ttyd + tmux)
After=network.target console-pi-dashboard.service

[Service]
Type=exec
ExecStart=/opt/console-pi/scripts/term-launch.sh ssh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

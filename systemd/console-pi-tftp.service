[Unit]
Description=Console Pi - May chu TFTP (sao luu/phuc hoi config, firmware switch)
# Khong Requires gi ca: dich vu nay bat/tat theo yeu cau nguoi dung tu
# dashboard, khong tu chay luc khoi dong (TFTP khong co xac thuc).
#
# Dung rieng unit nay, KHONG dung "tftpd-hpa.service" co san cua goi Debian:
# goi tftpd-hpa mac dinh se tu bat + tu enable dich vu cua no khi cai dat
# (postinst script), di nguoc nguyen tac "khong tu bat dich vu mang khong
# xac thuc luc boot" cua du an nay. Console Pi tu quan ly rieng unit nay va
# tat unit mac dinh cua goi ngay sau khi cai (xem huong dan trong giao
# dien web).

[Service]
Type=simple
# Tu tao thu muc goc neu chua co - dich vu phai TU DU, khong duoc phu thuoc
# hoan toan vao viec tftp_server.py da chay bat_tftp() truoc do. Da gap
# that: khoi dong thang unit nay (vd de kiem thu) ma bo qua ham Python thi
# in.tftpd thoat ngay voi ma loi 66/NOINPUT vi thu muc chua ton tai.
# Quyen 777 co chu dich: in.tftpd chay duoi user rieng "tftp" (giam quyen
# sau --user tftp ben duoi), can ghi duoc de nhan file switch gui len.
ExecStartPre=/bin/mkdir -p /opt/console-pi/tftp
ExecStartPre=/bin/chmod 777 /opt/console-pi/tftp
# --foreground    : chay doc lap (khong can inetd) VA KHONG tu phan nhanh
#                   ve nen. DA GAP LOI THAT: dung "--listen" (khong co
#                   -L/--foreground) thi in.tftpd tu detach/fork ra khoi
#                   tien trinh cha ngay sau khi khoi dong - voi Type=simple,
#                   systemd thay tien trinh CHINH da thoat va coi nhu dich
#                   vu da dung (du con tien trinh con dang chay ngam), dan
#                   den trang thai "Deactivated successfully" ngay lap tuc
#                   ma khong bao loi gi ca. --foreground (theo man in.tftpd:
#                   "Similar to --listen but do not detach") giu dung mo
#                   hinh Type=simple can.
# --user tftp     : giam quyen sau khi mo cong 69 (goi tftpd-hpa da tao san
#                   user he thong "tftp" luc cai dat)
# --address       : chi lang nghe UDP/69, moi interface (loc theo interface
#                   thuc hien o tang mang neu can, TFTP khong co khai niem
#                   "interface=" nhu DHCP)
# --secure        : chi cho phep truy cap trong pham vi thu muc goc, chan
#                   moi duong dan co ".." vuot ra ngoai
# --create        : BAT BUOC de switch GHI duoc file len Pi (copy running-
#                   config tftp://). Thieu co nay thi tftpd chi cho DOC,
#                   giong het han che cua dnsmasq ma du an nay co chu dich
#                   tranh bang cach dung tftpd-hpa thay vi dnsmasq.
ExecStart=/usr/sbin/in.tftpd --foreground --user tftp --address 0.0.0.0:69 \
    --secure --create /opt/console-pi/tftp
Restart=on-failure
RestartSec=3

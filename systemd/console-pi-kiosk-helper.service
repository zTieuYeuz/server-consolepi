[Unit]
Description=Console Pi - Tiem nut Ve Dashboard + ban phim ao vao moi trang cua kiosk
After=console-pi-kiosk.service
Wants=console-pi-kiosk.service

[Service]
Type=simple
User=administrator
Group=administrator
ExecStart=/usr/bin/python3 /opt/console-pi/scripts/kiosk-helper.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

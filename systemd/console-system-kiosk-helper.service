[Unit]
Description=Console Pi - Tiem nut Ve Dashboard + ban phim ao vao moi trang cua kiosk
After=console-system-kiosk.service
Wants=console-system-kiosk.service

[Service]
Type=simple
User=administrator
Group=administrator
ExecStart=/usr/bin/python3 /opt/console-pi/scripts/kiosk-helper.py
Restart=always
RestartSec=3

[Install]
Alias=console-pi-kiosk-helper.service
WantedBy=multi-user.target

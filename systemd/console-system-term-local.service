[Unit]
Description=Console Pi - Terminal local (ttyd + tmux)
After=network.target console-system-dashboard.service

[Service]
Type=exec
ExecStart=/opt/console-pi/scripts/term-launch.sh local
Restart=always
RestartSec=3

[Install]
Alias=console-pi-term-local.service
WantedBy=multi-user.target
